{
  "version": 2,
  "alias": "dev-website-team-backend-one.vercel.app",
  "builds": [
    {
      "src": "./server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
     
     
